  "agentExpansionProtocol": {
    "requiredFields": [
      "agentId",
      "role",
      "reportsTo",
      "domain",
      "channelEntrypoint",
      "workspace",
      "notionDb",
      "promptProfile",
      "existenceCriteria",
      "differenceFromExistingAgent"
    ],
    "classifications": [
      "existing-agent-adjustment",
      "new-routine-for-existing-agent",
      "new-surface-or-channel",
      "new-canonical-role",
      "new-official-agent",
      "draft-artifact"
    ],
    "decisionRules": [
      "Prefer extending an existing agent when domain and ownership already match.",
      "Create a routine instead of an agent when only cadence or delivery changes.",
      "Create a surface instead of an agent when only the channel envelope changes.",
      "Register an official agent only after hierarchy, workspace, Notion flow and promptProfile are declared here."
    ]
  },
  "cronPayloadContract": {
    "policyVersion": "cron-deterministic-v1",
    "requiredFields": [
      "agentId",
      "promptProfile",
      "command",
      "outputContract",
      "policyVersion"
    ],
    "allowedPromptProfiles": [
      "deterministic-cron",
      "heartbeat"
    ],
    "rule": "Cron payloads must execute one explicit command and use structured command output as the source of truth."
  }
