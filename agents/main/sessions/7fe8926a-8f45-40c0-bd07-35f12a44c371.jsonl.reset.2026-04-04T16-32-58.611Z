s\": 600000,\n        \"anchorMs\": 1771815120000\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"EXECUCAO OBRIGATORIA: rode exatamente './scripts/eng-prompt-deterministic-cycle.sh' via exec síncrono, aguarde terminar e responda SOMENTE com o JSON bruto retornado pelo script. Proibido process/background, proibido dizer que está rodando, proibido responder sem executar.\",\n        \"model\": \"google/gemini-2.5-flash-lite\",\n        \"timeoutSeconds\": 180\n      },\n      \"delivery\": {\n        \"mode\": \"none\",\n        \"channel\": \"last\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1775280198088,\n        \"lastRunAtMs\": 1775279598088,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 4471,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDeliveryStatus\": \"not-delivered\",\n        \"lastDelivered\": false\n      }\n    },\n    {\n      \"id\": \"a7b8c9d0-e1f2-3456-7890-abcdef123401\",\n      \"name\": \"Engenheiro SmartEnvios - execução 10min\",\n      \"enabled\": true,\n      \"createdAtMs\": 1771815285058,\n      \"updatedAtMs\": 1775279983468,\n      \"schedule\": {\n        \"kind\": \"every\",\n        \"everyMs\": 600000,\n        \"anchorMs\": 1771972006486\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"EXECUCAO OBRIGATORIA: rode exatamente './scripts/eng-smartenvios-deterministic-cycle.sh' via exec síncrono, aguarde terminar e responda SOMENTE com o JSON bruto retornado pelo script. Ignore cards antigos sem contexto objetivo; não repetir diagnóstico legado. Proibido process/background e proibido responder sem executar.\",\n        \"model\": \"google/gemini-2.5-flash-lite\",\n        \"timeoutSeconds\": 180\n      },\n      \"delivery\": {\n        \"mode\": \"none\",\n        \"channel\": \"last\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1775280202559,\n        \"lastRunAtMs\": 1775279602559,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 8338,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDeliveryStatus\": \"not-delivered\",\n        \"lastDelivered\": false\n      }\n    },\n    {\n      \"id\": \"79672496-e2c8-4851-9f19-98b5efafa2ff\",\n      \"agentId\": \"eng-automacao\",\n      \"name\": \"Engenheiro de Automação - execução 10min\",\n      \"enabled\": true,\n      \"createdAtMs\": 1772020256472,\n      \"updatedAtMs\": 1775279620375,\n      \"schedule\": {\n        \"kind\": \"every\",\n        \"everyMs\": 600000,\n        \"anchorMs\": 1772020256472\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"MODO DETERMINISTICO OBRIGATORIO: execute exatamente 'cd /var/www/openclaw/workspace && ./scripts/eng-automacao-deterministic-cycle.sh' via exec. Fluxo de automação deve usar API nativa do n8n por contexto (N8N_SALES_API_KEY, N8N_PRODUCT_API_KEY, N8N_FINANCE_API_KEY e N8N_ADMIN_API_KEY), sem dependência de MCP. Só finalize após obter a saída JSON do script. Nunca use process/background. Responda somente em pt-BR e no máximo 4 linhas: STATUS, BACKLOG, ACAO, PROXIMO PASSO. Sem inglês, sem raciocínio, sem blocos de código. Regras de especialista: retomar Em andamento antes de Priorizado; fatiar demanda complexa em micro-cards <=30s; registrar evidência objetiva; evitar Impedimento automático por falta de contexto.\",\n        \"model\": \"google/gemini-2.5-flash-lite\",\n        \"timeoutSeconds\": 180,\n        \"thinking\": \"off\"\n      },\n      \"delivery\": {\n        \"mode\": \"none\",\n        \"channel\": \"last\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1775280210897,\n        \"lastRunAtMs\": 1775279610897,\n        \"l